---
import Base from '../layouts/Base.astro';
import Fresco from '../components/Fresco.astro';
import Beneath from '../components/Beneath.astro';
import Transactions from '../components/Transactions.astro';
import Research from '../components/Research.astro';
import { site } from '../data/site';
---
<Base current="transactions">
  <Fresco />
  <Beneath />

  <section class="surface">
    <article>
      <div class="view head" data-view="surface">
        <p class="eyebrow center">{site.surface.fresco.eyebrow}</p>
        <h1>{site.surface.fresco.headline}</h1>
      </div>
      <div class="view head" data-view="research" id="research">
        <p class="eyebrow center under">{site.surface.sinopia.eyebrow}</p>
        <h1>{site.surface.sinopia.headline}</h1>
      </div>

      {(site.surface.definition || site.surface.paragraphs.length > 0) && (
        <>
          <span class="ornament" aria-hidden="true">· · ·</span>
          <div class="gloss">
            {site.surface.paragraphs.map((p, i) => (
              <p class={i === 0 ? 'first' : ''}>
                {p.split('[^1]').map((part, j) => (
                  <>{j > 0 && <sup class="fnref"><a id="fnref-1" href="#fn-1" aria-label="Footnote 1">1</a></sup>}{part}</>
                ))}
              </p>
            ))}
            {site.surface.definition && (
              <p class="entry" id="fn-1">
                <a class="fnmark" href="#fnref-1" aria-label="Back to the text">1</a>
                <dfn class="headword">{site.surface.definition.headword}</dfn>
                <span class="ipa">{site.surface.definition.pronunciation}</span>
                <span class="pos">{site.surface.definition.partOfSpeech}.</span>
                <span class="sense">{site.surface.definition.sense}</span>
                <span class="origin">[{site.surface.definition.origin}]</span>
              </p>
            )}
          </div>
        </>
      )}
    </article>
  </section>

  <div class="view" data-view="surface">
    <Transactions />
  </div>
  <div class="view" data-view="research">
    <Research />
  </div>
</Base>

<style>
  .surface { padding: clamp(64px, 9vw, 112px) 0 clamp(40px, 6vw, 72px); display: flex; justify-content: center; }
  article { width: 100%; max-width: 1080px; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .center { text-align: center; }
  /* Both headlines share one size and position, so the two sides mirror each other. */
  .head { width: 100%; text-align: center; }
  .eyebrow.under { color: var(--sinopia); }
  h1 { margin: 0; text-align: center; font-family: var(--display); font-weight: 400; font-style: italic; font-size: clamp(30px, 3.7vw, 43px); line-height: 1.15; text-wrap: balance; }
  .head h1 { margin-top: 18px; }
  .response { margin: -4px 0 0; text-align: center; font-family: var(--display); font-size: clamp(22px, 2.4vw, 28px); line-height: 1.35; color: var(--ink-soft); text-wrap: balance; }
  .ornament { margin-top: clamp(20px, 3vw, 32px); color: var(--sinopia); letter-spacing: 0.4em; font-size: 18px; }
  .gloss { width: 100%; max-width: 720px; display: flex; flex-direction: column; gap: 16px; }
  /* On a computer screen the headline holds to one line. */
  @media (min-width: 1100px) { h1 { white-space: nowrap; } }
  .gloss p { margin: 0; font-size: 19px; line-height: 1.75; text-wrap: pretty; }
  .first::first-letter { float: left; font-family: var(--display); font-size: 64px; line-height: 0.8; padding: 6px 8px 0 0; color: var(--sinopia); }
  /* The definition hangs under the explanation like a footnote. */
  .gloss p.entry { position: relative; margin-top: 10px; padding-top: 14px; font-size: 16px; line-height: 1.6; color: var(--ink-soft); }
  .entry::before { content: ''; position: absolute; top: 0; left: 0; width: 120px; border-top: 1px solid rgba(42, 36, 32, 0.35); }
  .fnref { margin-left: 1px; font-size: 0.62em; line-height: 0; }
  .fnref a, .fnmark { color: var(--sinopia); text-decoration: none; font-family: var(--serif); }
  .fnref a:hover, .fnmark:hover { text-decoration: underline; }
  .fnmark { margin-right: 8px; font-size: 13px; vertical-align: super; line-height: 0; }
  .entry:target { background: rgba(138, 52, 32, 0.06); }
  .headword { font-family: var(--display); font-style: normal; font-weight: 500; font-size: 21px; letter-spacing: 0.01em; color: var(--sinopia); }
  .ipa { margin-left: 8px; }
  .pos { margin-left: 8px; font-style: italic; color: var(--ink); }
  .sense { margin-left: 6px; color: var(--ink); }
  .origin { display: block; margin-top: 2px; font-size: 15px; }
  .view { animation: flipin .7s ease both; }
  :global(html.js) [data-view='research'] { display: none; }
  :global(html.js.show-research) [data-view='research'] { display: block; }
  :global(html.js.show-research) [data-view='surface'] { display: none; }
</style>

<script>
  /**
   * Controller for the fresco: which giornate are lifted, which block is open,
   * and whether the page shows the surface (Transactions) or the research glossary.
   */
  const ids = ['neuroscience', 'mathematics', 'vita', 'engineering', 'cybernetics'];
  const lifted = new Set<string>();
  let sel: string | null = null;

  const root = document.documentElement;
  const patches = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-giornata]'));
  const beneath = document.getElementById('beneath') as HTMLElement;
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-block]'));
  const liftAll = document.querySelector<HTMLButtonElement>('[data-lift-all]')!;
  const navTx = document.querySelector<HTMLAnchorElement>('[data-nav="transactions"]');
  const navRs = document.querySelector<HTMLAnchorElement>('[data-nav="research"]');
  const nameOf = (id: string) => patches.find((p) => p.dataset.giornata === id)?.querySelector('.label')?.textContent ?? id;

  const allLifted = () => ids.every((id) => lifted.has(id));

  function scrollToId(id: string) {
    requestAnimationFrame(() => document.getElementById(id)?.scrollIntoView({ block: 'start' }));
  }

  function render() {
    const all = allLifted();
    for (const p of patches) {
      const id = p.dataset.giornata!;
      const on = lifted.has(id);
      p.classList.toggle('is-lifted', on);
      p.setAttribute('aria-pressed', String(on));
      p.setAttribute('aria-label', (on ? 'Restore the fresco over ' : 'Lift the fresco to see the work beneath: ') + nameOf(id));
    }
    const showBlock = !!sel && lifted.has(sel) && !all;
    beneath.hidden = !showBlock;
    for (const b of blocks) b.hidden = b.dataset.block !== sel;
    root.classList.toggle('show-research', all);
    liftAll.textContent = all ? 'Lay all the plaster back' : 'Lift the whole fresco';
    navTx?.setAttribute('aria-current', String(!all));
    navRs?.setAttribute('aria-current', String(all));
  }

  function toggle(id: string) {
    if (lifted.has(id)) {
      lifted.delete(id);
      if (sel === id) sel = ids.filter((x) => lifted.has(x)).pop() ?? null;
    } else {
      lifted.add(id);
      sel = id;
    }
    render();
  }

  function openOnly(id: string) {
    lifted.clear();
    lifted.add(id);
    sel = id;
    render();
    scrollToId('beneath');
  }

  function showResearch() {
    ids.forEach((id) => lifted.add(id));
    sel = null;
    render();
    scrollToId('research');
  }

  function showSurface(scrollTarget?: string) {
    lifted.clear();
    sel = null;
    render();
    if (scrollTarget) scrollToId(scrollTarget);
  }

  patches.forEach((p) => p.addEventListener('click', () => toggle(p.dataset.giornata!)));
  liftAll.addEventListener('click', () => (allLifted() ? showSurface() : showResearch()));
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => openOnly(b.dataset.open!)));
  document.querySelectorAll<HTMLButtonElement>('[data-restore]').forEach((b) => b.addEventListener('click', () => toggle(b.dataset.restore!)));

  // Header links work as in-page controls here, and as deep links from other pages.
  function fromHash() {
    const h = location.hash.replace('#', '');
    if (h === 'research') showResearch();
    else if (h === 'vita') openOnly('vita');
    else if (h === 'transactions') showSurface('transactions');
    else render();
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) =>
    a.addEventListener('click', (e) => {
      const target = { transactions: 'transactions', research: 'research', cv: 'vita' }[a.dataset.nav as 'transactions' | 'research' | 'cv'];
      if (!target) return;
      e.preventDefault();
      history.replaceState(null, '', '#' + target);
      fromHash();
    }),
  );
  window.addEventListener('hashchange', fromHash);
  fromHash();
</script>
