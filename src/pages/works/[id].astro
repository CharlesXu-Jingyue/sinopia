---
/**
 * The page for one work. Every item in the research glossary links here.
 * Publications show: role, title, authors (your name highlighted), venue, abstract,
 * and an APA reference with a link to the paper. Other items show their role and body.
 */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import { giornate } from '../../data/giornate';
import { site } from '../../data/site';
import { url, newTab } from '../../data/url';
import { apaParts } from '../../data/apa';
import { toys } from '../../components/toys';

export async function getStaticPaths() {
  const items = await getCollection('works', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const g = giornate.find((x) => x.id === d.giornata);
const isPub = d.category === 'publication';
const isMe = (name: string) => site.nameInAuthorLists.some((n) => n.toLowerCase() === name.toLowerCase());
const apa = isPub ? apaParts({ ...d, title: d.title }) : null;
const myApa = (s: string) => s === 'Xu, J.';
const linkHref = d.link ? url(d.link) : undefined;
const hasBody = Boolean(entry.body && entry.body.trim());
const Toy = d.toy ? toys[d.toy] : undefined;
---
<Base title={d.title} description={d.description} current="research">
  <article class="page">
    <BackLink fallback={url('/#research')} />
    <p class="eyebrow kind">{g?.name ?? 'Other'} · {d.category} · {d.date.getFullYear()}</p>

    <p class="role">{d.description}</p>
    <h1>{d.title}</h1>

    {isPub && (
      <>
        {d.authors && (
          <p class="authors">
            {d.authors.map((a, i) => (
              <>{i > 0 && ', '}{isMe(a) ? <strong class="me">{a}</strong> : a}</>
            ))}
          </p>
        )}
        <p class="venue">
          <em>{d.venue}</em>{d.status && <span> · {d.status}</span>}<span> · {d.date.getFullYear()}</span>
        </p>
        <div class="actions">
          {apa?.doiUrl && <a class="btn" href={apa.doiUrl} {...newTab(apa.doiUrl)}>Read the paper ↗</a>}
          {linkHref && linkHref !== apa?.doiUrl && <a class="btn ghost" href={linkHref} {...newTab(linkHref)}>Open ↗</a>}
        </div>
        {d.abstract && (
          <section class="abstract">
            <h2 class="eyebrow">Abstract</h2>
            <p>{d.abstract}</p>
          </section>
        )}
      </>
    )}

    {!isPub && linkHref && (
      <div class="actions"><a class="btn" href={linkHref} {...newTab(linkHref)}>Open it →</a></div>
    )}

    {Toy && <div class="embed"><Toy /></div>}

    {hasBody && <div class="body"><Content /></div>}

    {isPub && apa && (
      <section class="cite">
        <h2 class="eyebrow">Cite (APA)</h2>
        <p class="ref">
          {apa.names.map((n, i) => (
            <>
              {i > 0 && (i === apa.names.length - 1 && n !== '…' ? ', & ' : ', ')}
              {myApa(n) ? <strong>{n}</strong> : n}
            </>
          ))}
          {' '}({apa.year}). {apa.title}. <em>{apa.venue}{apa.volume && `, ${apa.volume}`}</em>{apa.issue && `(${apa.issue})`}{apa.pages && `, ${apa.pages}`}.
          {apa.doiUrl && <> <a href={apa.doiUrl} {...newTab(apa.doiUrl)}>{apa.doiUrl}</a></>}
        </p>
      </section>
    )}

  </article>
</Base>

<style>
  .page { max-width: 760px; margin: 0 auto; padding: clamp(20px, 3vw, 36px) 0 clamp(48px, 7vw, 96px); }
  .kind { color: var(--sinopia); margin: 0 0 18px; }
  .role { margin: 0 0 14px; font-size: 19px; line-height: 1.6; font-style: italic; color: var(--ink-soft); }
  h1 { margin: 0 0 18px; font-family: var(--display); font-weight: 400; font-size: clamp(32px, 4vw, 46px); line-height: 1.15; }
  .authors { margin: 0 0 6px; font-size: 18px; line-height: 1.6; }
  .me { font-weight: 500; color: var(--sinopia); }
  .venue { margin: 0 0 22px; font-size: 17px; color: var(--ink-soft); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 36px; }
  .btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 1px solid var(--sinopia); background: var(--sinopia); color: #f6f1e6; font-size: 16px; text-decoration: none; }
  .btn:hover { background: var(--sinopia-deep); color: #f6f1e6; }
  .btn.ghost { background: transparent; color: var(--sinopia); }
  .btn.ghost:hover { background: rgba(138, 52, 32, 0.08); color: var(--sinopia); }
  .abstract, .cite { margin-bottom: 36px; }
  .abstract h2, .cite h2 { margin: 0 0 10px; color: var(--ink-soft); }
  .abstract p { margin: 0; font-size: 19px; line-height: 1.75; text-wrap: pretty; }
  /* An embedded model is given more width than the text column. */
  .embed { width: min(1080px, calc(100vw - 2 * clamp(14px, 3vw, 40px))); margin: 8px 0 40px 50%; transform: translateX(-50%); }
  .body { font-size: 19px; line-height: 1.75; margin-bottom: 36px; }
  .ref { margin: 0; padding-left: 2em; text-indent: -2em; font-size: 17px; line-height: 1.65; overflow-wrap: anywhere; }
</style>
