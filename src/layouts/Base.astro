---
import '../styles/global.css';
import { site } from '../data/site';
import { url, newTab } from '../data/url';

interface Props {
  title?: string;
  description?: string;
  /** Which header link to mark as current: 'transactions' | 'research' | undefined */
  current?: string;
}
const { title, description = site.description, current } = Astro.props;
const pageTitle = title ? `${title} · ${site.author}` : `${site.author} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('/images/og.jpg'), Astro.site)} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400&family=Nanum+Brush+Script&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="site-bar">
      <div class="wrap site-head">
        <a class="site-name" href={url('/')}>{site.author}</a>
        <nav class="site-nav" aria-label="Primary">
          <a href={url('/#transactions')} data-nav="transactions" aria-current={current === 'transactions' ? 'true' : undefined}>Transactions</a>
          <a href={url('/#research')} data-nav="research" aria-current={current === 'research' ? 'true' : undefined}>Research</a>
          <a href={url('/#vita')} data-nav="cv">CV</a>
        </nav>
      </div>
    </header>
    <div class="wrap">
      <slot />
    </div>
    <footer class="site-foot">
      <div class="wrap foot-inner">
        <span class="affil">{site.affiliation}</span>
        <div class="foot-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.github} {...newTab(site.github)}>GitHub</a>
          <a href={site.scholar} {...newTab(site.scholar)}>Google Scholar</a>
        </div>
      </div>
    </footer>
    <script>
      // External links (also those written in Markdown) open in a new tab.
      for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]')) {
        if (a.host !== location.host) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
      }

      // The header bar shows a hairline once the page has scrolled under it.
      const root = document.documentElement;
      const mark = () => root.classList.toggle('scrolled', window.scrollY > 4);
      mark();
      window.addEventListener('scroll', mark, { passive: true });

      // On a narrow screen the nav wraps under the name. Let the name row scroll away
      // and keep only the nav row pinned, so the strip stays thin.
      const bar = document.querySelector<HTMLElement>('.site-bar')!;
      const nav = bar.querySelector<HTMLElement>('.site-nav')!;
      const name = bar.querySelector<HTMLElement>('.site-name')!;
      const fit = () => {
        const wrapped = nav.offsetTop > name.offsetTop + name.offsetHeight / 2;
        const hide = wrapped ? nav.offsetTop : 0;
        bar.style.top = `${-hide}px`;
        root.style.scrollPaddingTop = `${bar.offsetHeight - hide + 12}px`;
      };
      fit();
      window.addEventListener('resize', fit);
    </script>
  </body>
</html>
