---
/**
 * The fresco and its sinopia. Each giornata is a button clipped to its polygon;
 * the controller script in pages/index.astro toggles `.is-lifted` on it.
 */
import { IMAGE, giornate, seams, clipPath, points } from '../data/giornate';
---
<figure class="fresco" id="top">
  <div class="mount">
    <div class="wall" style={`aspect-ratio: ${IMAGE.width} / ${IMAGE.height}`}>
      <div class="sinopia" aria-hidden="true" style={`background-image: url(${IMAGE.sinopia})`}></div>

      {giornate.map((g) => (
        <div class="float">
          <button
            class="giornata"
            type="button"
            data-giornata={g.id}
            aria-pressed="false"
            aria-label={`Lift the fresco to see the work beneath: ${g.name}`}
            style={`clip-path: ${clipPath(g.polygon)}`}
          >
            <span class="paint" aria-hidden="true" style={`background-image: url(${IMAGE.fresco})`}></span>
            <span class="label" style={`left: ${g.label.x}%; top: ${g.label.y}%`}>{g.name}</span>
          </button>
        </div>
      ))}

      <svg class="seams" viewBox={`0 0 ${IMAGE.width} ${IMAGE.height}`} preserveAspectRatio="none" aria-hidden="true">
        {seams.map((s) => <polyline points={points(s)} />)}
      </svg>
    </div>
  </div>
  <figcaption>
    <span class="muted">Five giornate. Touch one to lift the plaster and see the work beneath.</span>
    <button class="ctl" type="button" data-lift-all>Lift the whole fresco</button>
  </figcaption>
</figure>

<style>
  .fresco { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .mount { padding: clamp(8px, 1.4vw, 16px); background: var(--plaster-deep); box-shadow: inset 0 0 0 1px rgba(42, 36, 32, 0.12); }
  .wall { position: relative; width: 100%; background: var(--arriccio); }
  .sinopia, .paint { position: absolute; inset: 0; background-size: 100% 100%; background-repeat: no-repeat; }
  .float { position: absolute; inset: 0; pointer-events: none; transition: transform .5s cubic-bezier(.2, .7, .2, 1), filter .5s ease; }
  .float:hover, .float:focus-within { transform: translateY(-7px); filter: drop-shadow(0 12px 14px rgba(40, 26, 14, 0.38)); }
  .giornata { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: none; background: transparent; cursor: pointer; pointer-events: auto; }
  .giornata:focus-visible { outline: none; }
  .paint { transition: opacity 1.6s ease; }
  .giornata.is-lifted .paint { opacity: 0; }
  .label { position: absolute; padding: 4px 12px; background: rgba(233, 226, 212, 0.94); color: var(--ink); font-family: var(--serif); font-size: 16px; font-style: italic; letter-spacing: 0.04em; white-space: nowrap; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2); pointer-events: none; opacity: 0; transform: translate(-50%, -50%) translateY(4px); transition: opacity .4s ease, transform .4s ease; }
  .giornata:hover .label, .giornata:focus-visible .label { opacity: 1; transform: translate(-50%, -50%); }
  .seams { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; fill: none; stroke: rgba(60, 40, 24, 0.3); stroke-width: 1; stroke-linejoin: round; }
  .seams polyline { vector-effect: non-scaling-stroke; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 24px; font-size: 15px; }
  @media (prefers-reduced-motion: reduce) { .float:hover, .float:focus-within { transform: none; } }
</style>
