---
/**
 * A line of text in which the fresco words (giornata, fresco, sinopia) open a small card:
 * a dictionary entry and what the word means on this site. The card opens on hover or
 * keyboard focus, and stays open on click or tap until Escape, another click, or a click elsewhere.
 * Usage: <Glossed text="Lift a giornata to see the work behind." />
 */
import { terms } from '../data/terms';

interface Props {
  text: string;
}
const { text } = Astro.props;
const words = Object.keys(terms);
const pattern = new RegExp(`\\b(${words.join('|')})\\b`, 'gi');
const parts = text.split(pattern);
const uid = Math.random().toString(36).slice(2, 8);
---
{parts.map((part, i) => {
  const key = part.toLowerCase();
  const t = i % 2 === 1 ? terms[key] : undefined;
  if (!t) return part;
  const id = `term-${key}-${uid}-${i}`;
  return (
    <span class="term" data-term>
      <button class="term-word" type="button" aria-expanded="false" aria-controls={id}>{part}</button>
      <span class="term-card" id={id} role="note">
        <span class="tc-entry">
          <dfn class="tc-head">{t.headword}</dfn>
          <span class="tc-ipa">{t.pronunciation}</span>
          <span class="tc-pos">{t.partOfSpeech}.</span>
        </span>
        <span class="tc-sense">{t.sense}</span>
        <span class="tc-origin">[{t.origin}]</span>
        <span class="tc-here-label">On this site</span>
        <span class="tc-here">{t.here}</span>
      </span>
    </span>
  );
})}

<style>
  .term { position: relative; display: inline-block; }
  .term:hover, .term:focus-within, .term.open { z-index: 40; }
  .term-word { padding: 0; border: none; background: none; font: inherit; letter-spacing: inherit; text-transform: inherit; color: inherit; cursor: help; text-decoration: underline dotted; text-decoration-thickness: 1px; text-underline-offset: 0.22em; text-decoration-color: color-mix(in srgb, currentColor 55%, transparent); }
  .term-word:hover, .term.open .term-word { color: var(--sinopia); text-decoration-color: var(--sinopia); }

  /* The card. The padding-top is a bridge so the pointer can travel from the word into the card. */
  .term-card {
    position: absolute; top: 100%; left: 50%; z-index: 40;
    width: min(360px, calc(100vw - 32px));
    padding-top: 10px;
    transform: translate(calc(-50% + var(--shift, 0px)), 4px);
    display: flex; flex-direction: column;
    visibility: hidden; opacity: 0;
    transition: opacity .18s ease, transform .18s ease, visibility 0s linear .18s;
    text-align: left; text-transform: none; letter-spacing: normal; white-space: normal;
    font-family: var(--serif); font-style: normal; font-weight: 400; font-size: 15.5px; line-height: 1.55; color: var(--ink);
    pointer-events: none;
  }
  .term-card::before {
    content: ''; position: absolute; inset: 10px 0 0 0; z-index: -1;
    background: #f3eee3; border: 1px solid rgba(42, 36, 32, 0.22);
    box-shadow: 0 10px 28px rgba(42, 36, 32, 0.16), 0 2px 6px rgba(42, 36, 32, 0.08);
  }
  .tc-entry, .tc-sense, .tc-origin, .tc-here { padding: 0 18px; }
  .tc-entry { padding-top: 14px; }
  .tc-here { padding-bottom: 16px; }
  /* Near the bottom of the window the card opens upward instead. */
  .term-card.up { top: auto; bottom: 100%; padding-top: 0; padding-bottom: 10px; }
  .term-card.up::before { inset: 0 0 10px 0; }
  @media (hover: hover) {
    .term:hover .term-card { visibility: visible; opacity: 1; transform: translate(calc(-50% + var(--shift, 0px)), 0); transition-delay: 0s; pointer-events: auto; }
  }
  .term:focus-within .term-card, .term.open .term-card { visibility: visible; opacity: 1; transform: translate(calc(-50% + var(--shift, 0px)), 0); transition-delay: 0s; pointer-events: auto; }
  .term.closed .term-card { visibility: hidden; opacity: 0; pointer-events: none; }

  .tc-head { font-family: var(--display); font-style: normal; font-weight: 500; font-size: 21px; color: var(--sinopia); }
  .tc-ipa { margin-left: 8px; color: var(--ink-soft); }
  .tc-pos { margin-left: 8px; font-style: italic; color: var(--ink-soft); }
  .tc-sense { margin-top: 4px; }
  .tc-origin { margin-top: 4px; font-size: 14px; color: var(--ink-soft); }
  .tc-here-label { margin: 12px 18px 0; padding: 10px 0 0; border-top: 1px solid rgba(42, 36, 32, 0.15); font-size: 11.5px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--sinopia); }
  .tc-here { margin-top: 4px; }
</style>

<script>
  const terms = Array.from(document.querySelectorAll<HTMLElement>('[data-term]'));

  // Keep the card inside the viewport by shifting it sideways.
  function place(term: HTMLElement) {
    const card = term.querySelector<HTMLElement>('.term-card')!;
    card.style.setProperty('--shift', '0px');
    const r = card.getBoundingClientRect();
    const margin = 16;
    let shift = 0;
    if (r.left < margin) shift = margin - r.left;
    else if (r.right > window.innerWidth - margin) shift = window.innerWidth - margin - r.right;
    card.style.setProperty('--shift', `${shift}px`);
    // Open upward when the card would run under the footer strip and there is room above.
    card.classList.remove('up');
    const foot = document.querySelector('.site-foot')?.getBoundingClientRect().height ?? 0;
    const below = window.innerHeight - foot - term.getBoundingClientRect().bottom;
    const above = term.getBoundingClientRect().top - (document.querySelector('.site-bar')?.getBoundingClientRect().bottom ?? 0);
    if (r.height > below && above > below) card.classList.add('up');
  }

  function setOpen(term: HTMLElement, open: boolean) {
    term.classList.toggle('open', open);
    // After an explicit close, suppress hover/focus showing until the pointer leaves.
    term.classList.toggle('closed', !open);
    term.querySelector('.term-word')!.setAttribute('aria-expanded', String(open));
    if (open) place(term);
  }

  for (const term of terms) {
    const word = term.querySelector<HTMLButtonElement>('.term-word')!;
    term.addEventListener('mouseenter', () => { term.classList.remove('closed'); place(term); });
    term.addEventListener('mouseleave', () => { if (!term.contains(document.activeElement)) term.classList.remove('closed'); });
    word.addEventListener('focus', () => place(term));
    word.addEventListener('blur', () => term.classList.remove('closed'));
    word.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = !term.classList.contains('open');
      terms.forEach((t) => t !== term && t.classList.contains('open') && setOpen(t, false));
      setOpen(term, open);
    });
  }
  document.addEventListener('click', (e) => {
    for (const t of terms) if (t.classList.contains('open') && !t.contains(e.target as Node)) setOpen(t, false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const t of terms) {
      if (t.classList.contains('open') || t.contains(document.activeElement)) {
        setOpen(t, false);
        t.querySelector<HTMLButtonElement>('.term-word')!.focus();
      }
    }
  });
</script>
